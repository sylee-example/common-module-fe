# 사내 Nexus 레지스트리 설정
# 인증 토큰은 커밋하지 말고 CI 환경변수(NPM_AUTH_TOKEN)로 주입
@company:registry=https://nexus.your-company.com/repository/npm-group/
//nexus.your-company.com/repository/npm-group/:_authToken=${NPM_AUTH_TOKEN}
//nexus.your-company.com/repository/npm-hosted/:_authToken=${NPM_AUTH_TOKEN}
always-auth=true
